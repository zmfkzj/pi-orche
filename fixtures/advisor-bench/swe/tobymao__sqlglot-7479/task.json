  "id": "tobymao__sqlglot-7479",
  "title": "Enhancement: richer typed handling for BigQuery AI.* scalar functions",
  "repo": "tobymao/sqlglot",
  "baseCommit": "38357253ee1f2847bd14e0a7b68baf5a2c0a2228",
